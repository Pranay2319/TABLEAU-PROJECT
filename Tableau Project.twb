      <aliases enabled='yes' />
      <column caption='Profit Ratio' datatype='real' name='[Calculation_1261740737220608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='Last Order Date' datatype='date' name='[Calculation_1261740740829185]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [Customer Name] : MAX([Order Date]) }' />
      </column>
      <column caption='Reference Date' datatype='date' name='[Calculation_1261740740984834]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ MAX([Order Date]) }' />
      </column>
      <column caption='Recency' datatype='integer' name='[Calculation_1261740741095427]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Calculation_1261740740829185], [Calculation_1261740740984834])' />
      </column>
      <column caption='Frequency' datatype='integer' name='[Calculation_1261740741308420]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Customer Name] : COUNTD([Order ID]) }' />
      </column>
      <column caption='Monetary Value' datatype='integer' name='[Calculation_1261740741402629]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Customer Name] : SUM([Sales]) }' />
      </column>
      <column caption='High Value Customer' datatype='string' name='[Calculation_1261740743557126]' role='dimension' type='nominal'>
